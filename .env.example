# Copy to .env. Keep secrets out of version control.
PORT=3000
HOST=0.0.0.0
BASE_URL=http://localhost:3000

# disabled | mock (local only) | test | live
XENDIT_MODE=disabled
XENDIT_ACCEPT_NEW_ORDERS=false
XENDIT_API_KEY=
XENDIT_WEBHOOK_TOKEN=
XENDIT_BUSINESS_ID=
# Default selection and allowed checkout methods. Activate each in Xendit Dashboard.
XENDIT_CHANNEL_CODE=SHOPEEPAY
XENDIT_CHANNEL_CODES=SHOPEEPAY,OVO,DANA
# Add QRIS only after Xendit confirms its acquiring route is migrated from LinkAja.
XENDIT_PAYMENT_TTL_SECONDS=3600

VOTE_PRICE=5000
MAX_VOTES_PER_ORDER=1000
SHOW_RESULTS=true
ADMIN_KEY=
DB_PATH=./data/starlight.db
# Test Mode must use a separate file. Default: DB_PATH with .test.db appended.
# XENDIT_TEST_DB_PATH=./data/starlight-test.db
# TRUST_PROXY=loopback
