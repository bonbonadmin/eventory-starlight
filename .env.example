# Copy this file to .env and fill in the values.

PORT=3000

# Public URL of this site, used for Xendit redirect URLs after payment.
# In development with a tunnel (e.g. ngrok), use the tunnel URL.
BASE_URL=http://localhost:3000

# Xendit secret API key (Dashboard > Settings > API Keys).
# Leave empty to run in MOCK mode: payments are simulated locally, no Xendit calls.
XENDIT_SECRET_KEY=

# Xendit callback verification token (Dashboard > Settings > Webhooks).
# Set the "Invoices paid" webhook URL to: <BASE_URL>/api/xendit/callback
XENDIT_CALLBACK_TOKEN=

# Price per vote in IDR, and the max number of votes in one purchase.
VOTE_PRICE=5000
MAX_VOTES_PER_ORDER=1000

# How long a payment link stays valid, in seconds.
INVOICE_DURATION=3600

# Show live vote totals on the public page (true/false).
SHOW_RESULTS=true

# Key for GET /api/admin/results and /api/admin/orders (send as header "x-admin-key").
ADMIN_KEY=change-me

# SQLite database file path.
DB_PATH=./data/starlight.db
